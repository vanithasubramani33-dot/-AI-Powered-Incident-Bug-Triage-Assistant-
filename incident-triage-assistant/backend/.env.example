PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/incident_triage
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:3000,http://localhost:3001

# Optional: if set, the AI triage engine will call this OpenAI-compatible
# endpoint instead of the built-in rule-based engine. Leave blank to always
# use the rule-based fallback (fully functional with no external service).
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
